/* boîtes à lumière */
function softbox(x,z){
  var g=new THREE.Group();
  for(var i=0;i<3;i++){var a=i/3*Math.PI*2;var leg=box(.05,1.6,.05,chromeMat);leg.position.set(Math.cos(a)*.5,.75,Math.sin(a)*.5);leg.rotation.z=Math.cos(a)*.35;leg.rotation.x=-Math.sin(a)*.35;g.add(leg)}
  var pole=box(.06,3.8,.06,chromeMat);pole.position.y=2.6;g.add(pole);
  var sb=new THREE.Group();
  var shell=new THREE.Mesh(new THREE.CylinderGeometry(.95,.25,.9,4,1,true),new THREE.MeshStandardMaterial({color:0x111418,roughness:.6,side:THREE.DoubleSide}));shell.rotation.x=Math.PI/2;shell.rotation.y=Math.PI/4;sb.add(shell);
  var face=new THREE.Mesh(new THREE.PlaneGeometry(1.34,1.34),glowMat);face.position.z=.46;sb.add(face);
  sb.position.y=4.3;g.add(sb);
  g.position.set(x,0,z);scene.add(g);
  var dx=-x,dz=-2-z;sb.rotation.order='YXZ';sb.rotation.y=Math.atan2(dx,dz);sb.rotation.x=Math.atan2(2,Math.hypot(dx,dz));
  var L=new THREE.SpotLight(0xe8f4ff,.9,30,.8,.9,1.2);L.position.set(x,4.3,z);L.target.position.set(0,2,-2);scene.add(L,L.target);
  contact(x,z,.9,.55);
}
softbox(-6.5,-5.5);softbox(6.8,-4.2);

/* éclairage du studio (calculé une seule fois : on peut se permettre la qualité) */
scene.add(new THREE.HemisphereLight(0xcfe8ff,0x0b1630,.42));
var fill=new THREE.DirectionalLight(0xbfe6f7,.5);fill.position.set(-4,6,10);scene.add(fill);
scene.add(new THREE.AmbientLight(0x7cc4f0,.1));
var key=new THREE.SpotLight(0xffffff,2.3,22,.42,.6,1.1);key.position.set(0,H-.5,-1);key.target.position.set(0,0,-2);key.castShadow=true;key.shadow.mapSize.set(small?1024:2048,small?1024:2048);key.shadow.bias=-.0003;key.shadow.radius=6;scene.add(key,key.target);

var pool=new THREE.PointLight(0x7cc4f0,.6,5,2);pool.position.set(0,2.2,-2);scene.add(pool);

/* reflets de l'environnement sur les métaux */
var pmrem=new THREE.PMREMGenerator(renderer);
scene.background=BG;
scene.environment=pmrem.fromScene(scene,.03).texture;

/* outil interne : pré-calcul de la version téléphone */
window.__bakeDiamond=function(w,h,n){
  renderer.setRenderTarget(null);renderer.setPixelRatio(1);renderer.setSize(w,h,false);
  var c=new THREE.PerspectiveCamera(2*Math.atan(PK*Math.tan(32*Math.PI/180))*180/Math.PI,w/h,.1,100);c.position.set(0,3.9,10.5);c.lookAt(0,1.1,-2);
  renderer.setClearColor(0x000000,0);sparks.forEach(function(sp){sp.visible=false});
  var out=[];for(var i=0;i<n;i++){diamond.rotation.set(0,i/n*Math.PI/4,0);diamond.position.y=DY;renderer.render(dscene,c);out.push(canvas.toDataURL('image/png'))}
  return out;
};
window.__bakePhone=function(w,h){
  renderer.setRenderTarget(null);renderer.setPixelRatio(1);renderer.setSize(w,h,false);
  var c=new THREE.PerspectiveCamera(2*Math.atan(PK*Math.tan(32*Math.PI/180))*180/Math.PI,w/h,.1,100);c.position.set(0,3.9,10.5);c.lookAt(0,1.1,-2);
  renderer.setClearColor(BG,1);renderer.shadowMap.needsUpdate=true;renderer.render(scene,c);
  var room=canvas.toDataURL('image/jpeg',.86);
  renderer.setSize(256,256,false);
  var cc=new THREE.CubeCamera(.1,60,new THREE.WebGLCubeRenderTarget(16));cc.position.set(0,DY,-2);cc.updateMatrixWorld(true);
  var faces=cc.children.map(function(cm){renderer.render(scene,cm);return canvas.toDataURL('image/jpeg',.85)});
  return {room:room,cube:faces};
};
/* ---------- Cadrage ---------- */
var endPos=new THREE.Vector3(),startPos=new THREE.Vector3(),target=new THREE.Vector3();
function frameCamera(w,h){
  camera.aspect=w/h;var m=camera.aspect<.8;
  camera.fov=m?64:46;camera.updateProjectionMatrix();
  endPos.set(0,m?3.9:3.7,10.5);
  startPos.set(0,m?3.6:3.4,15.5);           /* 5 mètres plus loin */
  target.set(m?0:-2.4,m?1.1:3.0,-2);
  camera.position.copy(endPos);camera.lookAt(target);
}

/* ---------- Rendu du studio en haute qualité (une seule fois, gardé sur la carte graphique) ---------- */
var lastW=0,lastH=0,runPR=1,livePR=1;
var bgRT=null,bgScene=new THREE.Scene(),bgCam=new THREE.OrthographicCamera(-1,1,1,-1,0,1);
var bgQuad=new THREE.Mesh(new THREE.PlaneGeometry(2,2),new THREE.MeshBasicMaterial({toneMapped:false,depthTest:false,depthWrite:false}));bgScene.add(bgQuad);
function bake(){
  var w=studio.clientWidth,h=studio.clientHeight;if(!w||!h)return;lastW=w;lastH=h;
  frameCamera(w,h);
  runPR=Math.min(DPR,2,Math.sqrt((small?1.6e6:2.6e6)/(w*h)));
  livePR=Math.min(DPR,small?.8:1,Math.sqrt((small?.45e6:.95e6)/(w*h)));
  var bp=Math.min(runPR*1.6,Math.min(4096,maxTex)/Math.max(w,h),Math.sqrt((small?3e6:9e6)/(w*h)));
  if(bgRT)bgRT.dispose();
  bgRT=new THREE.WebGLRenderTarget(Math.round(w*bp),Math.round(h*bp),{minFilter:THREE.LinearFilter,magFilter:THREE.LinearFilter,format:THREE.RGBAFormat,generateMipmaps:false,depthBuffer:true,encoding:THREE.sRGBEncoding});
  camera.position.copy(endPos);camera.lookAt(target);
  renderer.setRenderTarget(bgRT);renderer.setClearColor(BG,1);renderer.shadowMap.needsUpdate=true;
  renderer.clear();renderer.render(scene,camera);renderer.setRenderTarget(null);
  bgQuad.material.map=bgRT.texture;bgQuad.material.needsUpdate=true;
  setMode();
  return Promise.resolve();
}
/* deux modes : marche (studio en temps réel, résolution allégée) puis fixe (studio HQ + diamant animé) */
var walking=false,walkStart=0,WALK=3.4,wl=0,wa=0,wn=0;
function setMode(){
  var w=studio.clientWidth,h=studio.clientHeight;
  renderer.setClearColor(BG,1);
  if(walking){renderer.setPixelRatio(livePR);renderer.setSize(w,h,false)}
  else{renderer.setPixelRatio(runPR);renderer.setSize(w,h,false);camera.position.copy(endPos);camera.lookAt(target)}
}
function endWalk(){walking=false;studio.classList.add('walked');setMode()}
var rt;
addEventListener('resize',function(){clearTimeout(rt);rt=setTimeout(function(){var w=studio.clientWidth,h=studio.clientHeight;if(Math.abs(w-lastW)>40||Math.abs(h-lastH)>160){try{bake()}catch(e){}}},400)});
canvas.addEventListener('webglcontextlost',function(e){e.preventDefault();canvas.style.display='none';studio.classList.add('walked','nogl');ready(true)});

/* ---------- Animation ---------- */
var visible=true;
if('IntersectionObserver' in window){new IntersectionObserver(function(e){visible=e[0].isIntersecting}).observe(studio)}
var hover=matchMedia('(hover:hover) and (pointer:fine)').matches&&!reduce;
var mx=0,my=0,smx=0,smy=0;
if(hover)addEventListener('pointermove',function(e){mx=e.clientX/innerWidth-.5;my=e.clientY/innerHeight-.5},{passive:true});
document.getElementById('skip').addEventListener('click',function(){ready(true);if(walking)endWalk()});
function easeIO(x){return x<.5?2*x*x:1-Math.pow(-2*x+2,2)/2}

var clock=new THREE.Clock();
function frame(){
  requestAnimationFrame(frame);
  if(!visible||document.hidden)return;
  var t=clock.getElapsedTime(),rs=reduce?0:1;
  diamond.rotation.y=t*.32*rs;
  diamond.rotation.z=Math.sin(t*.5)*.035*rs;
  diamond.position.y=DY+Math.sin(t*.9)*.12*rs;
  for(var k=0;k<sparks.length;k++){var sp=sparks[k];var u=(t*sp.userData.sp+sp.userData.ph)%3;var o=u<.5?Math.sin(u/.5*Math.PI):0;if(u>2.9)placeSpark(sp);sp.material.opacity=o*rs;var s=.16+o*.4;sp.scale.set(s,s,1);sp.material.rotation=t}
  if(walking){
    var p=Math.min(1,(performance.now()-walkStart)/1000/WALK),e=easeIO(p),fade=1-e;
    camera.position.lerpVectors(startPos,endPos,e);
    /* pas de marche : léger balancement qui s'éteint à l'arrivée */
    camera.position.y+=Math.abs(Math.sin(p*Math.PI*7))*.05*fade;
    camera.position.x+=Math.sin(p*Math.PI*3.5)*.04*fade;
    camera.lookAt(target);
    renderer.autoClear=true;renderer.render(scene,camera);
    renderer.autoClear=false;renderer.render(dscene,camera);renderer.autoClear=true;
    /* si l'ordinateur peine pendant l'entrée, on allège tout de suite */
    var nw=performance.now();if(wl){wa+=nw-wl;wn++;if(wn===8){if(wa/wn>20&&livePR>.5){livePR*=.8;setMode()}wa=0;wn=0}}wl=nw;
    if(p>=.9)studio.classList.add('txt');
    if(p>=1)endWalk();
    return;
  }
  if(hover&&(Math.abs(mx-smx)>.0005||Math.abs(my-smy)>.0005)){smx+=(mx-smx)*.05;smy+=(my-smy)*.05;par.style.transform='translate3d('+(-smx*14).toFixed(2)+'px,'+(-smy*9).toFixed(2)+'px,0) scale(1.025)'}
  renderer.autoClear=true;renderer.render(bgScene,bgCam);
  renderer.autoClear=false;renderer.render(dscene,camera);renderer.autoClear=true;
}
Promise.race([Promise.all([logoReady,document.fonts?document.fonts.ready:Promise.resolve()]),new Promise(function(r){setTimeout(r,2500)})]).then(function(){
  try{buildCubes()}catch(e){}
  try{return bake()}catch(e){}
}).catch(function(){}).then(function(){
  /* la marche commence quand les portes sont ouvertes */
  var wait=Math.max(0,1700-performance.now());
  setTimeout(function(){requestAnimationFrame(function(){
    if(!reduce&&!studio.classList.contains('instant')){walking=true;walkStart=performance.now();setMode()}else{studio.classList.add('walked')}
    ready();frame();
  })},wait);
});

}
})();
</script>

</body></html>
