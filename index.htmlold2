<script>
(function(){
"use strict";
var LOGO="data:image/jpeg;base64,";
var reduce=window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches;

/* ---------- En-tête au défilement ---------- */
var header=document.querySelector('header');
function onScroll(){header.classList.toggle('solid',window.scrollY>40)}
addEventListener('scroll',onScroll,{passive:true});onScroll();

/* ---------- Copier ---------- */
function tap(el,fn){
  var last=0;
  function run(e){var now=Date.now();if(now-last<450){if(e&&e.cancelable)e.preventDefault();return}last=now;fn(e)}
  el.addEventListener('touchend',function(e){if(e.cancelable)e.preventDefault();run(e)},{passive:false});
  el.addEventListener('click',run);
}
function copyText(t){
  return new Promise(function(ok,no){
    function legacy(){
      try{
        var ta=document.createElement('textarea');ta.value=t;ta.setAttribute('readonly','');
        ta.style.cssText='position:fixed;top:0;left:0;width:1px;height:1px;opacity:0;font-size:16px;border:0;padding:0';
        document.body.appendChild(ta);
        var r=document.createRange();r.selectNodeContents(ta);var s=getSelection();s.removeAllRanges();s.addRange(r);
        ta.select();ta.setSelectionRange(0,99999);
        var res=document.execCommand('copy');document.body.removeChild(ta);s.removeAllRanges();
        res?ok():no();
      }catch(e){no()}
    }
    if(navigator.clipboard&&window.isSecureContext){
      try{navigator.clipboard.writeText(t).then(ok,legacy)}catch(e){legacy()}
    }else legacy();
  });
}
document.querySelectorAll('.copy').forEach(function(b){
  tap(b,function(){
    var t=b.getAttribute('data-copy');
    copyText(t).then(function(){
      b.innerHTML=BI('Copié','Copied');b.classList.add('ok');
      clearTimeout(b._t);b._t=setTimeout(function(){b.innerHTML=BI('Copier','Copy');b.classList.remove('ok')},1800);
    },function(){sel(b)});
  });
});
function sel(b){try{var a=b.previousElementSibling;var r=document.createRange();r.selectNodeContents(a);var s=getSelection();s.removeAllRanges();s.addRange(r)}catch(e){}
  b.innerHTML=BI('Sélectionné','Selected');clearTimeout(b._t);b._t=setTimeout(function(){b.innerHTML=BI('Copier','Copy')},1800)}
function BI(f,e){return '<span class="i-fr">'+f+'</span><span class="i-en">'+e+'</span>'}

/* ---------- Jauges de performance (exemple) ---------- */
var g=[["Performance",98],["Accessibilité",100],["Bonnes pratiques",100],["SEO",100]];
document.getElementById('gauges').innerHTML=g.map(function(x){
  var c=2*Math.PI*44,o=c*(1-x[1]/100);
  return '<div class="gauge"><svg viewBox="0 0 100 100" role="img" aria-label="'+x[0]+' '+x[1]+' sur 100"><circle cx="50" cy="50" r="44" fill="none" stroke="#ffffff1f" stroke-width="6"/><circle cx="50" cy="50" r="44" fill="none" stroke="#7cc4f0" stroke-width="6" stroke-linecap="round" stroke-dasharray="'+c.toFixed(1)+'" stroke-dashoffset="'+o.toFixed(1)+'" transform="rotate(-90 50 50)"/><text x="50" y="59" text-anchor="middle">'+x[1]+'</text></svg><small>'+BI(x[0],({'Accessibilité':'Accessibility','Bonnes pratiques':'Best practices'})[x[0]]||x[0])+'</small></div>';
}).join('');


/* ---------- Langues : français, anglais, espagnol ---------- */
var I18N={en:{"Vidéo": "Video", "Sites web": "Websites", "Local": "Local", "Mission": "Mission", "À propos": "About", "Contact": "Contact", "BOÎTE DE": "PRODUCTION", "PRODUCTION": "COMPANY", "120 IPS · ISO 800": "120 FPS · ISO 800", "Boîte de production vidéo & web": "Video & web production company", "Votre image, taillée comme": "Your image, cut like", "un diamant.": "a diamond.", "Vidéos publicitaires 4K, du tournage au montage final, et sites internet optimisés pour faire grandir votre entreprise.": "4K promotional videos, from filming to final edit, and optimized websites to help your business grow.", "Lancer mon projet": "Start my project", "Nos services": "Our services", "Passer l'entrée": "Skip intro", "Production vidéo": "Video production", "Des vidéos qui font briller votre marque": "Videos that make your brand shine", "On s'occupe de tout, de l'idée jusqu'au fichier final, pour que votre produit ou votre commerce soit vu sous son meilleur angle.": "We handle everything, from the idea to the final file, so your product or business is seen from its best angle.", "Caméra 4K · son pro": "4K camera · pro sound", "Clé en main": "Turnkey", "Tournage 4K": "4K filming", "Des images nettes et cinématographiques, captées avec une caméra 4K et du matériel audio de qualité, pour que chaque détail de votre produit ou de votre entreprise ressorte.": "Sharp, cinematic footage captured with a 4K camera and quality audio gear, so every detail of your product or business stands out.", "Montage Premiere Pro": "Premiere Pro editing", "Rythme, étalonnage des couleurs, son et animation : un montage professionnel réalisé dans Premiere Pro pour un rendu soigné du début à la fin.": "Pacing, color grading, sound and animation: a professional edit made in Premiere Pro for a polished result from start to finish.", "De A à Z": "A to Z", "Concept, tournage, montage et livraison : notre équipe gère toutes les étapes. Vous n'avez qu'à approuver le résultat.": "Concept, filming, editing and delivery: our team handles every step. All you have to do is approve the result.", "Concept": "Concept", "On définit votre message et l'histoire à raconter.": "We define your message and the story to tell.", "Tournage": "Filming", "On filme en 4K, chez vous ou en studio.": "We shoot in 4K, at your place or in the studio.", "Montage": "Editing", "Couleur, son et rythme dans Premiere Pro.": "Color, sound and pacing in Premiere Pro.", "Livraison": "Delivery", "Des formats prêts pour le web et les réseaux.": "Formats ready for the web and social media.", "Création de sites internet": "Website design", "Des sites internet optimisés pour tout type de business": "Optimized websites for every type of business", "Restaurant, salon, entrepreneur ou boutique : on conçoit un site à votre image, pensé pour être trouvé, rapide à charger et facile à utiliser.": "Restaurant, salon, contractor or shop: we design a site that reflects you, built to be found, fast to load and easy to use.", "Rapide et parfait sur cellulaire": "Fast and perfect on mobile", "Un site léger qui s'affiche en un instant sur téléphone, tablette et ordinateur.": "A lightweight site that loads instantly on phone, tablet and computer.", "Trouvé sur Google": "Found on Google", "Référencement local, titres et descriptions optimisés pour que vos clients vous trouvent près de chez eux.": "Local SEO, optimized titles and descriptions so customers find you close to home.", "Pensé pour convertir": "Built to convert", "Boutons d'appel, formulaires et prise de rendez-vous placés là où vos clients en ont besoin.": "Call buttons, forms and booking placed exactly where your customers need them.", "Vos vidéos mises en valeur": "Your videos in the spotlight", "Vos contenus 4K intégrés directement au site pour un impact maximal.": "Your 4K content built right into the site for maximum impact.", "Performance": "Performance", "Accessibilité": "Accessibility", "Bonnes pratiques": "Best practices", "SEO": "SEO", "Restaurants": "Restaurants", "Salons & spas": "Salons & spas", "Construction": "Construction", "Commerces de détail": "Retail stores", "Cliniques": "Clinics", "Artisans": "Artisans", "Immobilier": "Real estate", "OBNL": "Nonprofits", "Fiers d'ici": "Proudly local", "On aime aider nos entreprises locales": "We love helping our local businesses", "Nos voisins, nos commerçants et nos entrepreneurs font vivre notre communauté. Les aider à rayonner, c'est ce qui nous motive chaque jour.": "Our neighbours, merchants and entrepreneurs keep our community alive. Helping them shine is what drives us every day.", "On se rencontre en personne": "We meet in person", "On vient voir votre commerce, on comprend votre réalité et on filme sur place.": "We visit your business, understand your reality and film on site.", "Des prix pensés pour les PME": "Prices designed for small businesses", "Des forfaits adaptés aux petites et moyennes entreprises, sans frais cachés.": "Packages tailored to small and medium businesses, with no hidden fees.", "Un partenaire à long terme": "A long-term partner", "Mises à jour du site, nouvelles vidéos, conseils : on reste là après le lancement.": "Site updates, new videos, advice: we're still here after launch.", "« Quand une entreprise d'ici gagne en visibilité, c'est toute la communauté qui brille. »": "“When a local business gains visibility, the whole community shines.”", "Qui sommes-nous": "Who we are", "Deux jeunes entrepreneurs passionnés de communication": "Two young entrepreneurs passionate about communication", "On réfléchit d'abord à ce que votre message doit dire, puis à la meilleure façon de le montrer. On met notre expertise au service de chaque projet et de chaque client, en vidéo comme sur le web.": "We first think about what your message needs to say, then about the best way to show it. We put our expertise to work for every project and every client, on video and on the web.", "5 ans": "5 years", "d'expérience en montage vidéo": "of video editing experience", "de qualité d'image sur chaque tournage": "image quality on every shoot", "Parlons de votre projet": "Let's talk about your project", "Vidéo, site internet ou les deux : décrivez-nous votre idée et recevez une proposition sur mesure.": "Video, website or both: tell us your idea and get a custom proposal.", "Copier": "Copy", "Copié": "Copied", "Sélectionné": "Selected", "© 2026 Diamond Vision · Tous droits réservés": "© 2026 Diamond Vision · All rights reserved"}};
var LANG='fr',i18nNodes=[];
function T(fr){return LANG==='fr'?fr:(I18N[LANG][fr]||fr)}
function collectI18n(){
  var w=document.createTreeWalker(document.body,NodeFilter.SHOW_TEXT,null,false),n;
  while((n=w.nextNode())){
    var el=n.parentNode;if(!el||el.closest('script,style,.brand,.copy,.lang'))continue;
    var raw=n.nodeValue,key=raw.trim();if(!key||!(key in I18N.en))continue;
    var m=raw.match(/^(\s*)[\s\S]*?(\s*)$/);i18nNodes.push({n:n,key:key,pre:m[1],post:m[2]});
  }
}
function setLang(l){
  if(l!=='en')l='fr';LANG=l;document.documentElement.lang=l;
  var r=document.getElementById('dvl-'+l);if(r&&!r.checked)r.checked=true;
  document.querySelectorAll('.lang .lb').forEach(function(b){b.setAttribute('aria-pressed',b.getAttribute('data-l')===l?'true':'false')});
  try{localStorage.setItem('dv-lang',l)}catch(e){}
  movePill();
}
function movePill(){var b=document.querySelector('.lang .lb[aria-pressed="true"]'),pl=document.querySelector('.lang .pill');if(!b||!pl)return;pl.style.width=b.offsetWidth+'px';pl.style.transform='translateX('+b.offsetLeft+'px)'}
document.querySelectorAll('.lsw').forEach(function(r){r.addEventListener('change',function(){if(!r.checked)return;var l=r.id.slice(4);setLang(l);var b=document.querySelector('.lang .lb[data-l="'+l+'"]');if(b){b.classList.remove('pop');void b.offsetWidth;b.classList.add('pop')}})});
movePill();addEventListener('resize',movePill);if(document.fonts&&document.fonts.ready)document.fonts.ready.then(movePill);
(function(){var l='fr';try{l=localStorage.getItem('dv-lang')||'fr'}catch(e){}if(l!=='fr')setLang(l)})();

/* ---------- Scène 3D ----------
   Le studio est rendu une seule fois en haute qualité (image fixe très nette),
   puis seul le diamant est animé en temps réel par-dessus : fluide sur ordinateur comme sur téléphone. */
var studio=document.getElementById('studio');
function ready(instant){if(instant)studio.classList.add('instant');studio.classList.add('ready');var sk=document.getElementById('skip');setTimeout(function(){sk.hidden=true},instant?0:3800)}
setTimeout(function(){ready()},6200); /* filet de sécurité */
if(reduce){ready(true)}
var PHONE=matchMedia('(max-width: 820px)').matches,PK=1.45;
/* téléphone : tout est en images pré-calculées, aucune 3D à calculer */
if(PHONE){studio.classList.add('phone');document.getElementById('skip').hidden=true;setTimeout(function(){ready()},850);return}
/* ordinateur : le texte d'accueil apparaît une fois l'entrée terminée */
studio.classList.add('dk');setTimeout(function(){studio.classList.add('walked')},12000);
var tag=document.createElement('script');tag.src='https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js';
tag.onload=function(){initScene()};tag.onerror=function(){studio.classList.add('nogl');ready(true)};document.head.appendChild(tag);
function initScene(){
if(!window.THREE){studio.classList.add('nogl');ready(true);return}
var canvas=document.getElementById('scene'),bakeImg=document.getElementById('bake'),par=document.getElementById('par');
var renderer;
var DPR=Math.min(window.devicePixelRatio||1,3),small=Math.min(innerWidth,innerHeight)<700;
try{renderer=new THREE.WebGLRenderer({canvas:canvas,antialias:true,alpha:true,powerPreference:'high-performance'})}catch(e){studio.classList.add('nogl');ready(true);return}
renderer.outputEncoding=THREE.sRGBEncoding;
renderer.toneMapping=THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure=1.0;
renderer.shadowMap.enabled=true;
renderer.shadowMap.type=THREE.PCFSoftShadowMap;
renderer.shadowMap.autoUpdate=false;
var maxTex=renderer.capabilities.maxTextureSize||4096;

var scene=new THREE.Scene();      /* studio (rendu une fois) */
var dscene=new THREE.Scene();     /* diamant (animé) */
var BG=new THREE.Color(0x060c1a);
scene.fog=new THREE.Fog(0x060c1a,34,62);
var camera=new THREE.PerspectiveCamera(46,1,0.1,100);

var W=20,D=34,H=8,ZC=5,FRONT=ZC+D/2,BACK=ZC-D/2;
var BLUE=0x173462,PLAT=0xc9d1dc;

/* ---------- Le diamant : taille brillant (57 facettes) ---------- */
var DY=3.8;
function brilliantGeometry(){
  var pos=[],TAU=Math.PI*2,yt=.34,ygt=.02,ygb=-.02,yc=-1.32,rt=.54;
  function P(r,ang,y){return new THREE.Vector3(r*Math.cos(ang),y,r*Math.sin(ang))}
  function tri(a,b,c){
    var n=new THREE.Vector3().subVectors(b,a).cross(new THREE.Vector3().subVectors(c,a));
    var ce=new THREE.Vector3().add(a).add(b).add(c).divideScalar(3);ce.y+=.2;
    if(n.dot(ce)<0){var t=b;b=c;c=t}
    pos.push(a.x,a.y,a.z,b.x,b.y,b.z,c.x,c.y,c.z);
  }
  var st=TAU/8,T=[],S=[],G=[],Gh=[],B=[],Bh=[],Lp=[];
  for(var i=0;i<8;i++){
    var a=i*st,h=a+st/2;
    T.push(P(rt,a,yt));
    S.push(P(.78,h,yt-(yt-ygt)*.42));
    G.push(P(1,a,ygt));Gh.push(P(1,h,ygt));
    B.push(P(1,a,ygb));Bh.push(P(1,h,ygb));
    Lp.push(P(.2,h,ygb+(yc-ygb)*.8));
  }
  var top=new THREE.Vector3(0,yt,0),cul=new THREE.Vector3(0,yc,0);
  for(var k=0;k<8;k++){
    var n=(k+1)%8,p=(k+7)%8;
    tri(top,T[k],T[n]);                 /* table */
    tri(T[k],T[n],S[k]);                /* étoiles */
    tri(T[k],S[p],G[k]);tri(T[k],G[k],S[k]); /* bezels (cerf-volant) */
    tri(S[k],G[k],Gh[k]);tri(S[k],Gh[k],G[n]); /* haléfis supérieurs */
    tri(G[k],B[k],Gh[k]);tri(Gh[k],B[k],Bh[k]); /* rondiste */
    tri(Gh[k],Bh[k],G[n]);tri(G[n],Bh[k],B[n]);
    tri(B[k],Bh[k],Lp[k]);tri(Bh[k],B[n],Lp[k]); /* haléfis inférieurs */
    tri(cul,Lp[p],B[k]);tri(cul,B[k],Lp[k]);    /* pavillon */
  }
  var geo=new THREE.BufferGeometry();geo.setAttribute('position',new THREE.Float32BufferAttribute(pos,3));geo.computeVertexNormals();
  return geo;
}
var dGeo=brilliantGeometry();
/* environnement réel du studio vu depuis le diamant : reflets + réfraction (calculés une fois) */
function cubeAt(mapping){
  var rt=new THREE.WebGLCubeRenderTarget(small?128:512,{format:THREE.RGBAFormat,generateMipmaps:true,minFilter:THREE.LinearMipmapLinearFilter,encoding:THREE.sRGBEncoding});
  var cc=new THREE.CubeCamera(.1,60,rt);cc.position.set(0,DY,-2);scene.add(cc);renderer.shadowMap.needsUpdate=true;cc.update(renderer,scene);scene.remove(cc);
  if(mapping)rt.texture.mapping=mapping;return rt.texture;
}
function buildCubes(){
  var refl=cubeAt(null),refr=cubeAt(THREE.CubeRefractionMapping);
  [dBase.material,fR.material,fB.material].forEach(function(m){m.envMap=refr;m.needsUpdate=true});
  dTop.material.envMap=refl;dTop.material.needsUpdate=true;
}
var diamond=new THREE.Group();
/* réfraction principale (indice du diamant ≈ 2,42) */
var dBase=new THREE.Mesh(dGeo,new THREE.MeshBasicMaterial({refractionRatio:1/2.42,color:0xffffff}));dBase.material.color.setScalar(1.35);
/* dispersion : franges rouge et bleue légèrement décalées */
function fringe(col,ratio){return new THREE.Mesh(dGeo,new THREE.MeshBasicMaterial({refractionRatio:ratio,color:col,transparent:true,blending:THREE.AdditiveBlending,depthWrite:false}))}
var fR=fringe(0x7a2232,1/2.38),fB=fringe(0x22408f,1/2.48);
/* surface : reflets nets et éclats spéculaires */
var dTop=new THREE.Mesh(dGeo,new THREE.MeshPhongMaterial({color:0xffffff,reflectivity:.7,combine:THREE.MixOperation,specular:0xffffff,shininess:800,transparent:true,opacity:.55,depthWrite:false}));
dBase.renderOrder=1;fR.renderOrder=2;fB.renderOrder=2;dTop.renderOrder=3;
var dEdge=new THREE.LineSegments(new THREE.EdgesGeometry(dGeo,1),new THREE.LineBasicMaterial({color:0xffffff,transparent:true,opacity:.2,depthWrite:false}));dEdge.renderOrder=4;
diamond.add(dBase,fR,fB,dTop,dEdge);
diamond.scale.setScalar(1.55);
diamond.position.set(0,DY,-2);dscene.add(diamond);


/* lumières du diamant (scène animée uniquement : très léger) */
dscene.add(new THREE.AmbientLight(0xffffff,.25));
var dk=new THREE.PointLight(0xffffff,2.2,30);dk.position.set(0,H-.5,-1);dscene.add(dk);
var dl=new THREE.PointLight(0xbfe6f7,1.2,30);dl.position.set(-6,4.3,-5.5);dscene.add(dl);
var dr=new THREE.PointLight(0xbfe6f7,1.2,30);dr.position.set(6.8,4.3,-4.2);dscene.add(dr);
var dc=new THREE.PointLight(0xffffff,1,30);dc.position.set(0,4,10);dscene.add(dc);

/* éclats */
function sparkTex(){var c=document.createElement('canvas');c.width=c.height=128;var x=c.getContext('2d');var g=x.createRadialGradient(64,64,0,64,64,64);g.addColorStop(0,'rgba(255,255,255,1)');g.addColorStop(.18,'rgba(220,240,255,.8)');g.addColorStop(1,'rgba(255,255,255,0)');x.fillStyle=g;x.fillRect(0,0,128,128);x.fillStyle='#fff';x.fillRect(63,0,2,128);x.fillRect(0,63,128,2);return new THREE.CanvasTexture(c)}
var stx=sparkTex(),sparks=[];
for(var si=0;si<8;si++){var sp=new THREE.Sprite(new THREE.SpriteMaterial({map:stx,transparent:true,blending:THREE.AdditiveBlending,depthWrite:false,depthTest:false,opacity:0}));sp.userData={ph:Math.random()*10,sp:.6+Math.random()*.8};dscene.add(sp);sparks.push(sp)}
function placeSpark(sp){var a=Math.random()*Math.PI*2,y=(Math.random()-.3)*1.2;y*=.9;var rad=(y>0?1-y*1.1:1+y*.9)*1.5;sp.position.set(Math.cos(a)*rad,DY+y,-2+Math.sin(a)*rad+.2)}
sparks.forEach(placeSpark);



/* Marbre bleu nuit veiné d'argent */
function marbleTexture(){
  var s=small?1024:2048,c=document.createElement('canvas');c.width=c.height=s;var x=c.getContext('2d');
  x.fillStyle='#0b1630';x.fillRect(0,0,s,s);
  for(var i=0;i<420;i++){var r=60+Math.random()*300;var gr=x.createRadialGradient(0,0,0,0,0,r);var a=Math.random()*.06;gr.addColorStop(0,'rgba(74,144,217,'+a+')');gr.addColorStop(1,'rgba(74,144,217,0)');x.save();x.translate(Math.random()*s,Math.random()*s);x.fillStyle=gr;x.fillRect(-r,-r,2*r,2*r);x.restore()}
  function vein(w,a,blur){
    x.save();x.filter='blur('+blur+'px)';x.strokeStyle='rgba(205,218,234,'+a+')';x.lineWidth=w;x.lineJoin='round';x.beginPath();
    var px=Math.random()*s,py=-40,ang=Math.PI/2+(Math.random()-.5)*1.2;x.moveTo(px,py);
    while(py<s+40&&px>-120&&px<s+120){ang+=(Math.random()-.5)*.42;px+=Math.cos(ang)*22;py+=Math.abs(Math.sin(ang))*22+3;x.lineTo(px,py)}
    x.stroke();x.restore();
  }
  
  for(var v2=0;v2<16;v2++)vein(.7+Math.random()*.5,.3,.4);
  for(var v3=0;v3<14;v3++)vein(.8,.26,0);
  x.strokeStyle='rgba(201,209,220,.2)';x.lineWidth=3;x.strokeRect(1.5,1.5,s-3,s-3);
  var t=new THREE.CanvasTexture(c);t.wrapS=t.wrapT=THREE.RepeatWrapping;t.repeat.set(W/5,D/5);t.anisotropy=renderer.capabilities.getMaxAnisotropy();t.encoding=THREE.sRGBEncoding;return t;
}
/* marbre mural : grandes plaques polies, veinage en miroir (book-match) comme un vrai mur de marbre */
function wallMarbleTexture(silver){
  var SW=512,SH=1024,N=5,c=document.createElement('canvas');c.width=SW*N;c.height=SH;var x=c.getContext('2d');
  var sl=document.createElement('canvas');sl.width=SW;sl.height=SH;var y=sl.getContext('2d');
  var g=y.createLinearGradient(0,0,SW,SH);if(silver){g.addColorStop(0,'#d6dae0');g.addColorStop(.5,'#c8cdd4');g.addColorStop(1,'#bac0c9')}else{g.addColorStop(0,'#21457a');g.addColorStop(.5,'#1a3a6a');g.addColorStop(1,'#163260')}y.fillStyle=g;y.fillRect(0,0,SW,SH);
  for(var i=0;i<140;i++){var r=40+Math.random()*180,gr=y.createRadialGradient(0,0,0,0,0,r),a=Math.random()*.07;gr.addColorStop(0,'rgba(124,196,240,'+a+')');gr.addColorStop(1,'rgba(124,196,240,0)');y.save();y.translate(Math.random()*SW,Math.random()*SH);y.fillStyle=gr;y.fillRect(-r,-r,2*r,2*r);y.restore()}
  function vein(w,a,blur){
    y.save();y.filter='blur('+blur+'px)';y.strokeStyle=(silver&&w<4)?'rgba(104,113,128,'+(a*.9)+')':'rgba(226,236,248,'+a+')';y.lineWidth=w;y.lineJoin='round';y.beginPath();
    var px=Math.random()*SW*1.4-SW*.4,py=-30,ang=1.05+(Math.random()-.5)*.35;y.moveTo(px,py);
    while(py<SH+30&&px<SW+80){ang+=(Math.random()-.5)*.28;ang=Math.max(.75,Math.min(1.4,ang));px+=Math.cos(ang)*16;py+=Math.sin(ang)*16;y.lineTo(px,py)}
    y.stroke();y.restore();
  }
  
  for(var v2=0;v2<7;v2++)vein(.7+Math.random()*.5,.32,.4);
  for(var v3=0;v3<10;v3++)vein(.7,.24,0);
  for(var k=0;k<N;k++){x.save();if(k%2){x.translate((k+1)*SW,0);x.scale(-1,1)}else{x.translate(k*SW,0)}x.drawImage(sl,0,0);x.restore()}
  x.fillStyle='rgba(201,209,220,.28)';for(var j=1;j<N;j++)x.fillRect(j*SW-1,0,2,SH);
  var t=new THREE.CanvasTexture(c);t.anisotropy=renderer.capabilities.getMaxAnisotropy();t.encoding=THREE.sRGBEncoding;return t;
}
/* ombre de contact douce */
var contactTex=(function(){var c=document.createElement('canvas');c.width=c.height=128;var x=c.getContext('2d');var g=x.createRadialGradient(64,64,0,64,64,64);g.addColorStop(0,'rgba(0,0,0,.75)');g.addColorStop(.55,'rgba(0,0,0,.3)');g.addColorStop(1,'rgba(0,0,0,0)');x.fillStyle=g;x.fillRect(0,0,128,128);return new THREE.CanvasTexture(c)})();
function contact(x,z,r,o){var m=new THREE.Mesh(new THREE.PlaneGeometry(r*2,r*2),new THREE.MeshBasicMaterial({map:contactTex,transparent:true,opacity:o,depthWrite:false}));m.rotation.x=-Math.PI/2;m.position.set(x,.012,z);m.renderOrder=1;scene.add(m)}

/* Matériaux */
var MARBLE=marbleTexture();
var floorMat=new THREE.MeshStandardMaterial({map:MARBLE,roughness:.14,metalness:0,transparent:true,opacity:.9});
var wallMat=new THREE.MeshStandardMaterial({color:BLUE,roughness:.62,metalness:.08});
var panelMat=new THREE.MeshStandardMaterial({color:0x10264b,roughness:.92});
var platMat=new THREE.MeshStandardMaterial({color:PLAT,roughness:.26,metalness:.88});
var chromeMat=new THREE.MeshStandardMaterial({color:0xe7ebef,roughness:.12,metalness:1});
var blackMat=new THREE.MeshStandardMaterial({color:0x1a1d22,roughness:.45,metalness:.4});
var glowMat=new THREE.MeshBasicMaterial({color:0xd8f0fb});
var coveMat=new THREE.MeshBasicMaterial({color:0x7cc4f0});

function box(w,h,d,m){var b=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),m);b.castShadow=b.receiveShadow=true;return b}
function at(o,x,y,z){o.position.set(x,y,z);scene.add(o);return o}

/* Sol, murs, plafond */
var floor=new THREE.Mesh(new THREE.PlaneGeometry(W,D),floorMat);floor.rotation.x=-Math.PI/2;floor.position.z=ZC;floor.receiveShadow=true;scene.add(floor);
var under=new THREE.Mesh(new THREE.PlaneGeometry(W,D),new THREE.MeshBasicMaterial({color:0x0a1426}));under.rotation.x=-Math.PI/2;under.position.set(0,-H,ZC);scene.add(under);
var backMarble=new THREE.MeshStandardMaterial({map:wallMarbleTexture(),roughness:.22,metalness:0});
/* murs de côté : même marbre que le mur du fond */
var sideTex=wallMarbleTexture();sideTex.wrapS=THREE.RepeatWrapping;sideTex.repeat.set(D/W,1);
var sideMarble=new THREE.MeshStandardMaterial({map:sideTex,roughness:.22,metalness:0});
var backWall=box(W,H,.3,wallMat);backWall.material=[wallMat,wallMat,wallMat,wallMat,backMarble,wallMat];at(backWall,0,H/2,BACK);
var lw=box(.3,H,D,wallMat);lw.material=[sideMarble,wallMat,wallMat,wallMat,wallMat,wallMat];at(lw,-W/2,H/2,ZC);
var rw=box(.3,H,D,wallMat);rw.material=[wallMat,sideMarble,wallMat,wallMat,wallMat,wallMat];at(rw,W/2,H/2,ZC);
/* petites mousses acoustiques bleues (motif en dièdres alternés) */
