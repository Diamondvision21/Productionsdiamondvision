var bodyMat=new THREE.MeshStandardMaterial({color:0x1c1f25,roughness:.5,metalness:.35});
var rubberMat=new THREE.MeshStandardMaterial({color:0x0c0d10,roughness:.92,metalness:0});
var aluMat=new THREE.MeshStandardMaterial({color:0xa9b2bd,roughness:.3,metalness:.95});
var carbonMat=new THREE.MeshStandardMaterial({color:0x262a31,roughness:.35,metalness:.25});
var lensGlass=new THREE.MeshStandardMaterial({color:0x0c1424,roughness:.04,metalness:1});
var coatMat=new THREE.MeshStandardMaterial({color:0x2d2266,roughness:.05,metalness:.8,emissive:0x1b1450,emissiveIntensity:.6});
var markMat=new THREE.MeshBasicMaterial({color:0xd9dde3});
var mbMat=new THREE.MeshStandardMaterial({color:0x15171b,roughness:.6,metalness:.2,side:THREE.DoubleSide});
function rbox(w,h,d,r,m){
  var s=new THREE.Shape(),x=-w/2+r,y=-h/2+r,w2=w-2*r,h2=h-2*r;
  s.moveTo(x,y);s.lineTo(x+w2,y);s.lineTo(x+w2,y+h2);s.lineTo(x,y+h2);s.lineTo(x,y);
  var g=new THREE.ExtrudeGeometry(s,{depth:Math.max(.001,d-2*r),bevelEnabled:true,bevelThickness:r,bevelSize:r,bevelSegments:3,curveSegments:4});g.center();
  var me=new THREE.Mesh(g,m);me.castShadow=true;return me;
}
function cyl(r1,r2,len,m,seg){var c=new THREE.Mesh(new THREE.CylinderGeometry(r1,r2,len,seg||28),m);c.castShadow=true;return c}
function alongZ(o,x,y,z){o.rotation.x=Math.PI/2;o.position.set(x,y,z);return o}
var monTex=(function(){
  var c=document.createElement('canvas');c.width=256;c.height=160;var x=c.getContext('2d');
  var g=x.createLinearGradient(0,0,0,160);g.addColorStop(0,'#173462');g.addColorStop(1,'#0b1630');x.fillStyle=g;x.fillRect(0,0,256,160);
  x.fillStyle='#bfe6f7';x.beginPath();x.moveTo(108,62);x.lineTo(148,62);x.lineTo(160,74);x.lineTo(128,112);x.lineTo(96,74);x.closePath();x.fill();
  x.strokeStyle='rgba(255,255,255,.55)';x.lineWidth=1;x.strokeRect(20,14,216,132);
  x.beginPath();x.moveTo(128,70);x.lineTo(128,90);x.moveTo(118,80);x.lineTo(138,80);x.stroke();
  x.fillStyle='#ffffff';x.font='12px monospace';x.fillText('4K  120 IPS',26,30);x.fillText('F2.8  1/240',160,30);x.fillText('ISO 800',26,140);
  var t=new THREE.CanvasTexture(c);t.encoding=THREE.sRGBEncoding;return t;
})();
var monMat=new THREE.MeshBasicMaterial({map:monTex,toneMapped:false});
function cinemaCamera(){
  var g=new THREE.Group();
  /* trépied : jambes à deux sections, araignée au sol */
  var TOP=1.25,tilt=.33,L=TOP/Math.cos(tilt),reach=L*Math.sin(tilt);
  for(var i=0;i<3;i++){
    var a=i/3*Math.PI*2+Math.PI/6;
    var leg=new THREE.Group();leg.position.y=TOP;leg.rotation.y=a;
    var tl=new THREE.Group();tl.rotation.z=tilt;leg.add(tl);
    var up=box(.04,.74,.055,carbonMat);up.position.y=-.37;tl.add(up);
    var lock=box(.055,.05,.07,bodyMat);lock.position.y=-.72;tl.add(lock);
    var lo=box(.024,.66,.032,aluMat);lo.position.y=-1.0;tl.add(lo);
    var foot=box(.05,.04,.06,rubberMat);foot.position.y=-L+.02;tl.add(foot);
    g.add(leg);
    var sp=box(reach,.012,.02,aluMat);sp.position.set(Math.cos(-a)*reach/2,.06,Math.sin(-a)*reach/2);sp.rotation.y=a;g.add(sp);
  }
  var spider=cyl(.12,.12,.06,bodyMat,24);spider.position.y=TOP;g.add(spider);
  var bowl=cyl(.085,.07,.1,aluMat,24);bowl.position.y=TOP+.08;g.add(bowl);
  var hub=cyl(.03,.03,.03,aluMat,16);hub.position.y=.06;g.add(hub);
  /* tête fluide et manche */
  var head=rbox(.18,.15,.2,.02,bodyMat);head.position.y=1.43;g.add(head);
  var pan=new THREE.Group();pan.position.set(0,1.45,.1);pan.rotation.x=.42;
  var bar=alongZ(cyl(.013,.013,.55,aluMat,12),0,0,.27);pan.add(bar);
  var grip=alongZ(cyl(.022,.022,.15,rubberMat,16),0,0,.5);pan.add(grip);g.add(pan);
  var plate=box(.12,.02,.34,aluMat);plate.position.set(0,1.525,0);g.add(plate);
  /* tiges 15 mm */
  [-.045,.045].forEach(function(x){g.add(alongZ(cyl(.0095,.0095,.72,aluMat,10),x,1.56,-.06))});
  /* boîtier, poignée, batterie */
  var body=rbox(.17,.2,.3,.022,bodyMat);body.position.set(0,1.665,.02);g.add(body);
  var fan=box(.12,.13,.004,rubberMat);fan.position.set(0,1.665,.175);g.add(fan);
  var handle=rbox(.04,.03,.27,.01,rubberMat);handle.position.set(0,1.835,0);g.add(handle);
  [-.09,.09].forEach(function(z){var p=box(.025,.06,.025,bodyMat);p.position.set(0,1.79,z);g.add(p)});
  var batt=rbox(.13,.16,.06,.012,carbonMat);batt.position.set(0,1.66,.21);g.add(batt);
  var led=new THREE.Mesh(new THREE.BoxGeometry(.06,.006,.002),new THREE.MeshBasicMaterial({color:0x7cc4f0}));led.position.set(0,1.6,.241);g.add(led);
  /* viseur */
  g.add(alongZ(cyl(.026,.026,.14,bodyMat,20),-.115,1.72,.14));
  g.add(alongZ(cyl(.034,.03,.05,rubberMat,20),-.115,1.72,.235));
  /* moniteur latéral */
  var mon=new THREE.Group();mon.position.set(.17,1.86,-.02);mon.rotation.y=-.45;
  var mb=rbox(.2,.13,.024,.008,bodyMat);mon.add(mb);
  var scr=new THREE.Mesh(new THREE.PlaneGeometry(.178,.108),monMat);scr.position.z=.0125;mon.add(scr);g.add(mon);
  var arm=box(.012,.05,.012,aluMat);arm.position.set(.12,1.82,-.02);g.add(arm);
  /* monture et objectif */
  g.add(alongZ(cyl(.058,.058,.04,aluMat,32),0,1.665,-.15));
  g.add(alongZ(cyl(.05,.052,.3,bodyMat,32),0,1.665,-.31));
  g.add(alongZ(cyl(.057,.057,.05,rubberMat,40),0,1.665,-.24));
  g.add(alongZ(cyl(.057,.057,.06,rubberMat,40),0,1.665,-.37));
  g.add(alongZ(cyl(.0525,.0525,.006,markMat,32),0,1.665,-.205));
  g.add(alongZ(cyl(.0525,.0525,.004,markMat,32),0,1.665,-.305));
  g.add(alongZ(cyl(.062,.055,.06,bodyMat,36),0,1.665,-.48));
  var gl=new THREE.Mesh(new THREE.CircleGeometry(.052,36),lensGlass);gl.position.set(0,1.665,-.511);gl.rotation.y=Math.PI;g.add(gl);
  var ct=new THREE.Mesh(new THREE.CircleGeometry(.03,32),coatMat);ct.position.set(.006,1.672,-.512);ct.rotation.y=Math.PI;g.add(ct);
  /* suivi de point */
  var ff=box(.045,.06,.05,bodyMat);ff.position.set(.075,1.6,-.24);g.add(ff);
  var gear=cyl(.028,.028,.012,aluMat,24);gear.rotation.z=Math.PI/2;gear.position.set(.1,1.6,-.24);g.add(gear);
  /* compendium (matte box) et volets */
  var mbx=new THREE.Mesh(new THREE.CylinderGeometry(.14,.08,.13,4,1,true),mbMat);mbx.rotation.set(-Math.PI/2,Math.PI/4,0);mbx.position.set(0,1.665,-.58);g.add(mbx);
  var flagT=box(.2,.004,.11,mbMat);flagT.position.set(0,1.665+.1,-.66);flagT.rotation.x=-.12;g.add(flagT);
  [-1,1].forEach(function(s){var f=box(.004,.15,.1,mbMat);f.position.set(s*.1,1.665,-.66);f.rotation.y=s*.15;g.add(f)});
  g.scale.setScalar(1.4);
  return g;
}
var cam1=cinemaCamera();cam1.position.set(-4.2,0,3.2);cam1.lookAt(0,0,-2);cam1.rotateY(Math.PI);scene.add(cam1);
var cam2=cinemaCamera();cam2.position.set(3.3,0,2.4);cam2.lookAt(0,0,-2);cam2.rotateY(Math.PI);scene.add(cam2);
